# Shared viewer (read-only) admin key, used unless a per-env override below is set.
# WARNING: as of 2026-07-30 every discovered environment still uses APISIX's
# stock demo viewer key (4054f7cf07e344346cd3f287985e76a2) — rotate this in
# each environment's config.yaml before relying on this as an access control.
APISIX_VIEWER_KEY=
ADMIN_PORT=
GATEWAY_PORT=
CONTROL_PORT=
# Optional per-environment overrides, e.g.:
# APISIX_VIEWER_KEY__RAG_EDGE_DEV=
# APISIX_VIEWER_KEY__RAG_EDGE_STG=
# APISIX_VIEWER_KEY__SEVEN_DELI_DEV=
# APISIX_VIEWER_KEY__SEVEN_DELI_STG=
# APISIX_VIEWER_KEY__ALLCHAT_EDGE_STG=
